<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#F3E5F5">

    <ImageView
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/diluicao"
        android:contentDescription="Imagem de diluição"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="08 - Fórmula da Diluição"
        android:textSize="23sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="20dp"/>

    <EditText
        android:id="@+id/edtC1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Concentração C1"
        android:inputType="numberDecimal"/>

    <EditText
        android:id="@+id/edtV1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Volume V1"
        android:inputType="numberDecimal"/>

    <EditText
        android:id="@+id/edtC2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Concentração C2"
        android:inputType="numberDecimal"/>

    <Button
        android:id="@+id/btnCalcular"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="CALCULAR V2"
        android:layout_marginTop="20dp"/>

    <TextView
        android:id="@+id/txtResultado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Resultado:"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginTop="25dp"/>

</LinearLayout>