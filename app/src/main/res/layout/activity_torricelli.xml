<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#E0F7FA">

    <ImageView
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/torricelli"
        android:contentDescription="Imagem de movimento"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="07 - Equação de Torricelli"
        android:textSize="23sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="20dp"/>

    <EditText
        android:id="@+id/edtV0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Velocidade inicial (V0)"
        android:inputType="numberDecimal"/>

    <EditText
        android:id="@+id/edtAceleracao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Aceleração"
        android:inputType="numberDecimal"/>

    <EditText
        android:id="@+id/edtDeslocamento"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Deslocamento (Δs)"
        android:inputType="numberDecimal"/>

    <Button
        android:id="@+id/btnCalcular"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="CALCULAR"
        android:layout_marginTop="20dp"/>

    <TextView
        android:id="@+id/txtResultado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Resultado:"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginTop="25dp"/>

</LinearLayout>